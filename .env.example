# =============================================================================
# SyncStack - CRDT Collaborative Whiteboard & Kanban Configuration (.env.example)
# Copy this file to .env or .env.local to configure your environment.
# =============================================================================

# Server Port for the Yjs WebSocket Sync Server
PORT=1234

# Base WebSocket URL for client frontend connection
VITE_WS_URL=ws://localhost:1234

# Default Board Identifier (client-side UI default only)
VITE_DEFAULT_BOARD=board1

# NOTE: there is intentionally NO VITE_DEFAULT_TOKEN. VITE_* variables are
# inlined into the public browser bundle — shipping a token there published a
# working credential to every visitor. The client must obtain its token from
# the operator (URL query param / your own auth flow), and the server refuses
# to boot without SYNC_AUTH.

# SYNC_AUTH — REQUIRED by the server. Per-board token map. Two formats:
#   SYNC_AUTH="board1:tokenA,board2:tokenB"
#   SYNC_AUTH='{"board1":["tokenA","tokenB"]}'
# The server exits at boot without this. Tokens are never printed.
SYNC_AUTH=

# Optional CSWSH allowlist: comma-separated browser Origins permitted to open
# a WebSocket to the server (e.g. https://app.example.com,http://localhost:5173).
# Absent Origin (native clients, curl) is always allowed. Empty = no browser
# origins allowed.
SYNC_ALLOWED_ORIGINS=

# Empty room memory cleanup timeout in milliseconds (0 to disable)
VITE_ROOM_CLEANUP_TIMEOUT_MS=30000

# High-resolution raster export scale default (1 = 1x, 2 = Retina 2x, 3 = Ultra 3x)
VITE_EXPORT_PNG_SCALE=2
